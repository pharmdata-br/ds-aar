{
  "name": "@pharmdata/aar-ds",
  "version": "0.1.0",
  "description": "Design system do AAR, Ambiente de Análise Regulatória: tokens, componentes React e marca.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens": "./src/tokens/tokens.ts",
    "./tokens.json": "./src/tokens/tokens.json",
    "./tokens.css": "./src/tokens/tokens.css",
    "./fonts": "./src/fonts.ts",
    "./logos/*": "./assets/logos/*"
  },
  "files": ["src", "assets", "docs"],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run tokens && npm run typecheck && tsx scripts/render-check.tsx"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
